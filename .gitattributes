# 设备侧执行的文件必须是 LF：CRLF 会让 sh / magiskpolicy 解析失败
* text=auto eol=lf
*.sh          text eol=lf
*.rule        text eol=lf
*.conf        text eol=lf
*.prop        text eol=lf
*.xml         text eol=lf
*.md          text eol=lf
*.py          text eol=lf
*.java        text eol=lf
*.tpl         text eol=lf
*.json        text eol=lf
*.txt         text eol=lf
